[Unit]
Description=Quickshell (bar, power menu, launcher, clipboard, bindings help, notifications)
PartOf=graphical-session.target
After=graphical-session.target awww-daemon.service
Wants=awww-daemon.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
# gtk3, not kde6: the KDE platform theme only resolves themed icon names
# (dialog-information, folder...) when XDG_CURRENT_DESKTOP is KDE, under Hyprland it
# silently falls back to hicolor. gtk3 reads the icon theme from gsettings, which
# Theme.qml keeps in sync with kdeglobals.
Environment=QT_QPA_PLATFORMTHEME=gtk3
ExecStart=/usr/bin/qs -n
Restart=always
RestartSec=1
# hyprshutdown (launched by qs's power menu) forks/daemonizes to outlive
# Hyprland and run its --post-cmd (systemctl reboot/poweroff) afterwards.
# KillMode=control-group (the default) would kill that forked survivor
# along with qs when this unit stops, silently swallowing shutdown/reboot.
KillMode=process

[Install]
WantedBy=graphical-session.target
