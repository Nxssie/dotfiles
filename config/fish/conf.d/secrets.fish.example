# secrets.fish — TEMPLATE. Copy to ~/.config/fish/conf.d/secrets.fish (gitignored)
# and fill in the real values.
#
# fish auto-sources every ~/.config/fish/conf.d/*.fish at shell start, so these
# env vars are available whenever you launch opencode / pi / etc. from a shell.
#
# After editing the real file:  exec fish   (to reload)

# LiteLLM gateway — single entry/exit point for all inference providers.
# Virtual key issued from the gateway's admin panel (/keys), used by
# opencode.json {env:NX_LLM_GATEWAY_KEY} and pi/extensions/llm.ts.
set -gx NX_LLM_GATEWAY_KEY "sk-REPLACE_ME"

# acp-ssh-kmp release signing — self-signed PKCS12 keystore, read by
# android/build.gradle.kts to sign release builds outside CI. Same value for
# store/key password (PKCS12 doesn't support distinct ones). Mirrored as
# GitHub Actions secrets (base64 keystore + these two values) for CI signing.
set -gx ACP_SSH_KMP_RELEASE_KEYSTORE_PATH "$HOME/.config/acp-ssh-kmp/release.keystore.jks"
set -gx ACP_SSH_KMP_RELEASE_KEYSTORE_PASSWORD "REPLACE_ME"
set -gx ACP_SSH_KMP_RELEASE_KEY_ALIAS "acp-ssh-kmp-release"
set -gx ACP_SSH_KMP_RELEASE_KEY_PASSWORD "REPLACE_ME"
